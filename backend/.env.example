PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=replace_with_strong_secret
SECURITY_SEED_EMAIL=guardia@onalert.local
SECURITY_SEED_PASSWORD=Guardia123#
SECURITY_SEED_NAME=Guardia Demo

# Firebase Cloud Messaging (Admin SDK)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Supabase Storage
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=profile-photos

# Email (SMTP — Gmail recomendado con App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_16_chars

# Destinatarios de reportes de incidentes (separados por coma)
COORD_EMAILS=coordinador1@tesch.edu.mx,coordinador2@tesch.edu.mx
ADMIN_EMAILS=admin@tesch.edu.mx

# Render (auto-inyectado por Render en producción)
RENDER_EXTERNAL_URL=https://onalert-api.onrender.com

# Opciones
ALERT_COOLDOWN_SECONDS=30
